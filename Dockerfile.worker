FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY apps/worker/requirements.txt apps/worker/requirements.txt
RUN pip install --no-cache-dir -r apps/worker/requirements.txt

COPY apps/worker apps/worker
COPY apps/api apps/api
COPY services/pipeline services/pipeline
COPY packages/shared_types packages/shared_types

CMD ["python", "-m", "apps.worker.run"]
