{
  "rewrites": [
    { "source": "/auth/:path*", "destination": "https://api.steeze.ca/auth/:path*" },
    { "source": "/lectures", "destination": "https://api.steeze.ca/lectures" },
    { "source": "/lectures/:path*", "destination": "https://api.steeze.ca/lectures/:path*" },
    { "source": "/subjects", "destination": "https://api.steeze.ca/subjects" },
    { "source": "/uploads/:path*", "destination": "https://api.steeze.ca/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
